<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pathmemo</AssemblyName>
    <RootNamespace>PathMemo</RootNamespace>

    <!-- Raw MFT parsing and Struct-of-Arrays node storage need spans over
         unmanaged buffers (README section 5.3, 17.3). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Short-lived CLI process: workstation non-concurrent GC keeps RSS lowest.
         README section 17.3 budgets 250 MB at 1.2M files. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <!-- Avoids loading ICU (~30 MB) and keeps path comparison culture-free.
         All path matching is invariant by design (README section 12.2). -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The exe is meant to be double-clicked from Explorer (README section 2.1), and a
         generic console icon in a Downloads folder is not something anyone double-clicks.
         Regenerate with build\make-icon.ps1. -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!-- Trimming stays viable because there is no reflection-heavy dependency
         (README section 18): no Dapper, no DbUp, no Terminal.Gui. -->
    <IsTrimmable>true</IsTrimmable>

    <!-- P10: the three analysers that decide whether NativeAOT is reachable, on during an
         ordinary build rather than only at publish time. With TreatWarningsAsErrors they
         turn "works until it doesn't" into a compile error: reflection over a trimmed type,
         a dynamic code path, or an assembly location that a single file does not have.
         Keeping them on is the only way the AOT road stays open while the code grows
         (README section 19.4). -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Everything in this assembly is internal: it is an application, not a library.
         The test project needs to reach the scanner and snapshot types directly. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PathMemo.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Two package references, and no more (README section 18). Manual
         SqliteDataReader mapping, no Dapper: reflection would cost trimming. Sqlite
         brings the single native dependency, e_sqlite3.dll, which the single-file host
         extracts once per version (README section 19.2). System.IO.Hashing is pure
         managed code and brings nothing with it - which is the whole argument for
         XxHash128 over BLAKE3 (README section 8.2). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schema is one file, applied by PRAGMA user_version (README section 11).
         DbUp would add a package and break trimming for 25 lines of own code. -->
    <EmbeddedResource Include="Storage\Schema.sql" />
  </ItemGroup>

</Project>
