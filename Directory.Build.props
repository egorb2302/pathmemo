<Project>

  <PropertyGroup>
    <!-- net9.0-windows (not plain net9.0) so the heavy P/Invoke surface does not
         produce CA1416 platform-compatibility noise on every Win32 call.
         Deliberately NOT net9.0-windows10.0.x: that pulls in the CsWinRT
         projections (large ref pack, slower startup) and we only need classic
         Win32. The 1809 floor from README section 1 is enforced at runtime
         instead, by OsGuard. -->
    <TargetFramework>net9.0-windows</TargetFramework>

    <!-- A fixed version, not "latest": "latest" is whatever the installed SDK happens to
         offer, so the same source compiles differently on two machines. Raising this is
         then a deliberate commit rather than a surprise from an SDK update. -->
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Product>pathmemo</Product>
    <Company>pathmemo</Company>
    <Copyright>pathmemo contributors</Copyright>
    <!-- The release this source is heading for. The release workflow overrides it with the
         git tag, so a downloaded build always reports the tag it was cut from; a local
         build reports this number instead. They must be raised together with the tag, or
         the version a build prints is not the release it came from, which is the one thing
         a bug report cannot do without. The release workflow refuses a tag that disagrees
         with this number. -->
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>

    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
