<Project>

  <PropertyGroup>
    <!-- net9.0-windows (not plain net9.0) so the heavy P/Invoke surface does not
         produce CA1416 platform-compatibility noise on every Win32 call.
         Deliberately NOT net9.0-windows10.0.x: that pulls in the CsWinRT
         projections (large ref pack, slower startup) and we only need classic
         Win32. The 1809 floor from README section 1 is enforced at runtime
         instead, by OsGuard. -->
    <TargetFramework>net9.0-windows</TargetFramework>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Product>pathmemo</Product>
    <Company>pathmemo</Company>
    <Copyright>pathmemo contributors</Copyright>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
